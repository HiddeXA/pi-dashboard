[Unit]
Description=Pi Dashboard scherm (Chromium in kioskmodus)
After=systemd-user-sessions.service plymouth-quit-wait.service pi-dashboard.service
Wants=pi-dashboard.service
# Neemt het eerste scherm (tty1) over in plaats van het inlogscherm
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
ExecStart=/opt/pi-dashboard/kiosk/start-kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
