[Unit]
Description=Pi Dashboard scherm (Chromium in kioskmodus)
After=systemd-user-sessions.service plymouth-quit-wait.service pi-dashboard.service
Wants=pi-dashboard.service
# Neemt het eerste scherm (tty1) over in plaats van het inlogscherm.
# install.sh zet getty@tty1 uit, anders wint bij het opstarten soms het inlogscherm.
Conflicts=getty@tty1.service
# Blijf het scherm opnieuw proberen, ook als het een paar keer snel misgaat
StartLimitIntervalSec=0

[Service]
User=kiosk
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
ExecStart=/opt/pi-dashboard/kiosk/start-kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
